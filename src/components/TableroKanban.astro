---
// Componente: Tablero Kanban de Clientes (Accesible por Admin y Usuario Adjunto)
---
<section id="modulo-tablero" class="space-y-5">
  
  <!-- Barra de herramientas del tablero -->
  <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm flex flex-wrap items-center justify-between gap-4">
    <div>
      <h2 class="text-lg font-extrabold text-slate-900">📋 Tablero de Seguimiento de Clientes</h2>
      <p class="text-xs text-slate-500">Gestiona en qué etapa está cada prospecto que pregunta por Instagram o WhatsApp.</p>
    </div>

    <div class="flex items-center gap-2">
      <button onclick="abrirModalNuevoCliente()" class="px-4 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs sm:text-sm font-bold shadow transition">
        + Registrar Cliente Manual
      </button>
    </div>
  </div>

  <!-- Las 5 Columnas Kanban -->
  <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-4 items-start">
    
    <!-- Columna 1: Pidió info -->
    <div class="bg-slate-200/70 rounded-2xl p-3 border border-slate-200/80">
      <div class="flex items-center justify-between px-1 mb-3">
        <span class="text-xs font-extrabold uppercase tracking-wider text-sky-900 flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-sky-500"></span> Pidió info
        </span>
        <span id="count-Pidió info" class="mono text-xs font-bold bg-white px-2 py-0.5 rounded-full text-slate-700 shadow-sm">0</span>
      </div>
      <div id="col-Pidió info" class="space-y-3 min-h-[220px]"></div>
    </div>

    <!-- Columna 2: Pasé precio -->
    <div class="bg-slate-200/70 rounded-2xl p-3 border border-slate-200/80">
      <div class="flex items-center justify-between px-1 mb-3">
        <span class="text-xs font-extrabold uppercase tracking-wider text-indigo-900 flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span> Pasé precio
        </span>
        <span id="count-Pasé precio" class="mono text-xs font-bold bg-white px-2 py-0.5 rounded-full text-slate-700 shadow-sm">0</span>
      </div>
      <div id="col-Pasé precio" class="space-y-3 min-h-[220px]"></div>
    </div>

    <!-- Columna 3: Esperando pago -->
    <div class="bg-amber-100/60 rounded-2xl p-3 border border-amber-200">
      <div class="flex items-center justify-between px-1 mb-3">
        <span class="text-xs font-extrabold uppercase tracking-wider text-amber-900 flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span> Esperando pago
        </span>
        <span id="count-Esperando pago" class="mono text-xs font-bold bg-white px-2 py-0.5 rounded-full text-amber-900 shadow-sm">0</span>
      </div>
      <div id="col-Esperando pago" class="space-y-3 min-h-[220px]"></div>
    </div>

    <!-- Columna 4: Vendido -->
    <div class="bg-emerald-100/50 rounded-2xl p-3 border border-emerald-200">
      <div class="flex items-center justify-between px-1 mb-3">
        <span class="text-xs font-extrabold uppercase tracking-wider text-emerald-900 flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span> Vendido
        </span>
        <span id="count-Vendido" class="mono text-xs font-bold bg-white px-2 py-0.5 rounded-full text-emerald-900 shadow-sm">0</span>
      </div>
      <div id="col-Vendido" class="space-y-3 min-h-[220px]"></div>
    </div>

    <!-- Columna 5: Más adelante -->
    <div class="bg-slate-200/70 rounded-2xl p-3 border border-slate-200/80">
      <div class="flex items-center justify-between px-1 mb-3">
        <span class="text-xs font-extrabold uppercase tracking-wider text-slate-600 flex items-center gap-1.5">
          <span class="w-2.5 h-2.5 rounded-full bg-slate-400"></span> Más adelante
        </span>
        <span id="count-Más adelante" class="mono text-xs font-bold bg-white px-2 py-0.5 rounded-full text-slate-700 shadow-sm">0</span>
      </div>
      <div id="col-Más adelante" class="space-y-3 min-h-[220px]"></div>
    </div>

  </div>
</section>