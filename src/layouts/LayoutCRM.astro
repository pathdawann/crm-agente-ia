---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <script is:inline src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; }
    .mono { font-family: 'JetBrains Mono', monospace; }
  </style>
</head>
<body class="bg-slate-100 text-slate-900 min-h-screen flex flex-col">

  <!-- Barra Superior con Selector de Rol (Admin vs Usuario Adjunto) -->
  <header class="bg-slate-900 text-white border-b border-slate-800 sticky top-0 z-40">
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
      
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-xl bg-indigo-600 flex items-center justify-center font-extrabold text-sm shadow">
          IA
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="font-bold text-sm sm:text-base tracking-tight">CRM Agéntico IG & WA</h1>
            <span id="badgeRolActual" class="text-[11px] font-bold uppercase px-2 py-0.5 rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-400/30">
              👑 Admin
            </span>
          </div>
          <p class="text-[11px] text-slate-400 hidden sm:block">Fase 3: Agente IA Entrenado, Derivación a Humano, Sonido y Telegram</p>
        </div>
      </div>

      <!-- Simulador de Roles para probar permisos -->
      <div class="flex items-center gap-2 bg-slate-800 p-1 rounded-xl border border-slate-700">
        <span class="text-[11px] text-slate-400 px-2 hidden md:inline">Ver sistema como:</span>
        <button id="btnRolAdmin" onclick="cambiarRolSistema('admin')" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-indigo-600 text-white transition">
          👑 Administrador
        </button>
        <button id="btnRolAdjunto" onclick="cambiarRolSistema('adjunto')" class="px-3 py-1.5 rounded-lg text-xs font-bold text-slate-300 hover:text-white transition">
          👤 Usuario Adjunto (Equipo)
        </button>
      </div>

    </div>
  </header>

  <!-- Barra de Navegación del CRM -->
  <div class="bg-white border-b border-slate-200 shadow-sm">
    <div class="max-w-[1600px] mx-auto px-4 sm:px-6 flex items-center justify-between overflow-x-auto">
      <nav class="flex items-center gap-1 py-2">
        
        <button id="nav-tablero" onclick="mostrarModulo('tablero')" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-slate-900 text-white transition flex items-center gap-2">
          📋 Tablero de Clientes
        </button>

        <button id="nav-chats" onclick="mostrarModulo('chats')" class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold text-slate-600 hover:bg-slate-100 transition flex items-center gap-2">
          💬 Bandeja de Chats
          <span id="badgeMenuChats" class="mono text-[10px] bg-rose-600 text-white font-extrabold px-1.5 py-0.5 rounded-full">2</span>
        </button>

        <!-- Módulos exclusivos de Administrador -->
        <button id="nav-catalogo" onclick="mostrarModulo('catalogo')" class="solo-admin px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold text-slate-600 hover:bg-slate-100 transition flex items-center gap-2">
          📦 Mi Catálogo
          <span class="text-[10px] bg-indigo-100 text-indigo-700 font-bold px-1.5 py-0.5 rounded-md">Admin</span>
        </button>

        <button id="nav-agente" onclick="mostrarModulo('agente')" class="solo-admin px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold text-slate-600 hover:bg-slate-100 transition flex items-center gap-2">
          🤖 Configurar Agente IA
          <span class="text-[10px] bg-emerald-100 text-emerald-800 font-bold px-1.5 py-0.5 rounded-md">Activo</span>
        </button>

        <button id="nav-stats" onclick="mostrarModulo('stats')" class="solo-admin px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold text-slate-600 hover:bg-slate-100 transition flex items-center gap-2">
          📊 Estadísticas
          <span class="text-[10px] bg-emerald-100 text-emerald-800 font-bold px-1.5 py-0.5 rounded-md">En vivo</span>
        </button>

      </nav>

      <!-- Aviso visual cuando está activo el modo Usuario Adjunto -->
      <div id="avisoRestriccionAdjunto" class="hidden items-center gap-2 text-xs font-semibold text-amber-800 bg-amber-50 border border-amber-200 px-3 py-1.5 rounded-lg my-1">
        🔒 Vista restringida: Solo atención de clientes (Ajustes y Catálogo ocultos)
      </div>
    </div>
  </div>

  <!-- Contenido Principal -->
  <main class="flex-1 max-w-[1600px] w-full mx-auto px-4 sm:px-6 py-6">
    <slot />
  </main>

  <!-- Alerta Emergente en Pantalla cuando un cliente quiere comprar -->
  <div id="toastAlertaVenta" class="fixed bottom-5 right-5 z-50 hidden max-w-sm bg-slate-900 text-white border-2 border-rose-500 rounded-2xl p-4 shadow-2xl">
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-center gap-2.5">
        <span class="w-9 h-9 rounded-xl bg-rose-600 flex items-center justify-center text-lg shrink-0">🔔</span>
        <div>
          <span class="text-[10px] font-extrabold uppercase tracking-wider text-rose-400 block">¡Cliente listo para comprar!</span>
          <h4 id="toastTituloCliente" class="font-extrabold text-sm text-white">Nombre Cliente</h4>
        </div>
      </div>
      <button onclick="cerrarToastAlerta()" class="text-slate-400 hover:text-white text-xs font-bold">✕</button>
    </div>
    <p id="toastDetalleVenta" class="text-xs text-slate-300 mt-2"></p>
    <div class="mt-3 pt-2 border-t border-slate-800 flex items-center justify-between">
      <span class="text-[10px] text-sky-400 font-semibold">✈️ Respaldo enviado a Telegram</span>
      <button onclick="mostrarModulo('chats'); cerrarToastAlerta();" class="px-3 py-1 rounded-lg bg-rose-600 hover:bg-rose-500 text-white text-xs font-bold">
        Atender Chat ➔
      </button>
    </div>
  </div>

</body>
</html>