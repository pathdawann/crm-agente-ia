---
import LayoutCRM from '../layouts/LayoutCRM.astro';
import TableroKanban from '../components/TableroKanban.astro';
import CatalogoProductos from '../components/CatalogoProductos.astro';
import BandejaChats from '../components/BandejaChats.astro';
import ConfiguradorAgente from '../components/ConfiguradorAgente.astro';
import PanelEstadisticas from '../components/PanelEstadisticas.astro';
---

<LayoutCRM title="CRM Agéntico | Sistema Completo">
  
  <!-- Pieza 1: Tablero de Clientes -->
  <TableroKanban />

  <!-- Pieza 2: Bandeja de Chats y Automatizador de Comentarios a DM -->
  <BandejaChats />

  <!-- Pieza 3: Catálogo de Productos (Solo Admin) -->
  <CatalogoProductos />

  <!-- Pieza 4: Configurador del Agente IA + Sonido + Telegram (Solo Admin) -->
  <ConfiguradorAgente />

  <!-- Pieza 5: Panel de Estadísticas y Equipo (NUEVO EN FASE 4 - Solo Admin) -->
  <PanelEstadisticas />

  <!-- Modal para agregar un cliente manual -->
  <div id="modalNuevoCliente" class="fixed inset-0 bg-slate-900/60 hidden items-center justify-center p-4 z-50">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl border border-slate-200">
      <div class="flex items-center justify-between mb-4">
        <h3 class="font-extrabold text-base text-slate-900">➕ Nuevo Cliente en Tablero</h3>
        <button onclick="cerrarModalNuevoCliente()" class="text-slate-400 hover:text-slate-700 font-bold text-sm">✕</button>
      </div>
      <form id="formNuevoCliente" class="space-y-3">
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Nombre del Cliente *</label>
          <input type="text" id="cliNombre" required placeholder="Ej. Valentina Gómez" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-sm" />
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Producto que le interesa *</label>
          <select id="cliProducto" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-sm bg-white"></select>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Etapa Inicial</label>
            <select id="cliEtapa" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-sm bg-white">
              <option value="Pidió info">Pidió info</option>
              <option value="Pasé precio">Pasé precio</option>
              <option value="Esperando pago">Esperando pago</option>
              <option value="Vendido">Vendido</option>
              <option value="Más adelante">Más adelante</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-bold text-slate-700 mb-1">Usuario IG</label>
            <input type="text" id="cliIg" placeholder="@valentina" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-sm" />
          </div>
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 mb-1">Último comentario o consulta</label>
          <input type="text" id="cliNota" placeholder="Ej. Preguntó precio en el post de la franela" class="w-full px-3 py-2 rounded-xl border border-slate-300 text-sm" />
        </div>
        <div class="pt-2 flex justify-end gap-2">
          <button type="button" onclick="cerrarModalNuevoCliente()" class="px-4 py-2 rounded-xl border border-slate-200 text-xs font-bold text-slate-600">Cancelar</button>
          <button type="submit" class="px-4 py-2 rounded-xl bg-slate-900 text-white text-xs font-bold">Guardar Cliente</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Motor Javascript Completo (Fases 1, 2, 3 y 4) -->
  <script is:inline>
    const ETAPAS = ["Pidió info", "Pasé precio", "Esperando pago", "Vendido", "Más adelante"];
    let rolActual = "admin";
    let filtroChatActual = "todos";
    let chatSeleccionadoId = "chat-1";
    let moduloActivoActual = "tablero";
    let modoEstadisticas = "reales"; // 'reales' o 'muestra'

    const CONFIG_AGENTE_INICIAL = {
      rol: "Eres un asistente de ventas y consulta proactivo que atiende comentarios y DMs de Instagram. Explicas los productos del catálogo con sus precios y tallas disponibles, respondes dudas con amabilidad y, cuando el cliente está listo para comprar, derivas la conversación a un asesor humano para cerrar el pago.",
      tono: "Amistoso",
      longitud: "Media",
      demora: 3,
      limiteMensajes: 20,
      mensajeTransferencia: "Voy a derivar nuestra conversación a un especialista. Se pondrá en contacto contigo en breve.",
      sonidoActivo: true,
      tgBotToken: "",
      tgChatId: "",
      pautas: [
        "Comunica en primera persona, como un representante real de la marca, manteniendo un tono amigable y profesional.",
        "Saluda al cliente si es la primera interacción y su mensaje contiene un saludo.",
        "Solicita aclaraciones de manera cortés si la información proporcionada es incompleta o poco clara.",
        "Informa siempre el precio exacto y las tallas o variantes disponibles según el Catálogo.",
        "Cierra cada conversación confirmando los próximos pasos para reservar o comprar el producto.",
        "Cuando el cliente no responde: envía exactamente 1 oración continuando el tema sin saludos ni anuncios."
      ]
    };

    const CATALOGO_INICIAL = [
      {
        id: "prod-1",
        nombre: "Franela Negra Talla XS",
        precio: 25,
        stock: "Disponible",
        variantes: "también tenemos otras tallas (S, M, L) y modelos",
        keywords: "precio, franela, negra, xs, quiero, info"
      },
      {
        id: "prod-2",
        nombre: "Conjunto Deportivo Edición Especial",
        precio: 45,
        stock: "Pocas unidades",
        variantes: "también tenemos tallas S y M en color negro y azul marino",
        keywords: "conjunto, deportivo, catalogo, costo"
      }
    ];

    const CLIENTES_INICIALES = [
      {
        id: "cli-1",
        nombre: "Daniela Rojas",
        producto: "Franela Negra Talla XS ($25)",
        etapa: "Pasé precio",
        ig: "@danirojas_ve",
        nota: "Comentó 'precio' en el post -> El Bot le envió el DM con el precio de $25."
      },
      {
        id: "cli-2",
        nombre: "Carlos Méndez",
        producto: "Conjunto Deportivo Edición Especial ($45)",
        etapa: "Esperando pago",
        ig: "@carlosmendez",
        nota: "Listo para comprar. Derivado a humano para confirmar pago."
      }
    ];

    const CHATS_INICIALES = [
      {
        id: "chat-1",
        clienteId: "cli-1",
        nombre: "Daniela Rojas",
        ig: "@danirojas_ve",
        producto: "Franela Negra Talla XS",
        origen: "Comentario en Post IG",
        estado: "ia",
        noLeido: true,
        hora: "Hace 2 min",
        mensajes: [
          { autor: "comentario_cliente", texto: "Hola! precio de la franela negra por favor 🙌", hora: "10:14 AM" },
          { autor: "comentario_bot", texto: "Te hemos enviado un DM 📨", hora: "10:14 AM" },
          { autor: "ia_dm", texto: "¡Hola! Un gusto saludarte. El costo de la Franela Negra Talla XS es de $25, también tenemos otras tallas (S, M, L) y modelos por si te interesa. ¿Te gustaría reservar alguna?", hora: "10:14 AM" }
        ]
      },
      {
        id: "chat-2",
        clienteId: "cli-2",
        nombre: "Carlos Méndez",
        ig: "@carlosmendez",
        producto: "Conjunto Deportivo Edición Especial",
        origen: "Escribió directo al DM",
        estado: "humano",
        noLeido: true,
        hora: "Hace 5 min",
        mensajes: [
          { autor: "cliente_dm", texto: "Buenas tardes, vi el Conjunto Deportivo en sus historias, ¿qué precio tiene?", hora: "10:08 AM" },
          { autor: "ia_dm", texto: "¡Hola Carlos! Un gusto saludarte. El costo del Conjunto Deportivo Edición Especial es de $45, también tenemos tallas S y M en color negro y azul marino por si te interesa.", hora: "10:08 AM" },
          { autor: "cliente_dm", texto: "¡Excelente! Quiero comprar el talla M negro, ¿a dónde transfiero?", hora: "10:10 AM" },
          { autor: "ia_dm", texto: "Voy a derivar nuestra conversación a un especialista. Se pondrá en contacto contigo en breve.", hora: "10:10 AM" },
          { autor: "sistema", texto: "🔴 Intención de compra detectada: Alerta sonora activada y ficha de respaldo enviada a Telegram.", hora: "10:10 AM" }
        ]
      }
    ];

    const ALERTAS_TELEGRAM_INICIALES = [
      {
        id: "tg-1",
        fecha: "Hoy, 10:10 AM",
        cliente: "Carlos Méndez (@carlosmendez)",
        producto: "Conjunto Deportivo Edición Especial ($45)",
        ultimoMensaje: "¡Excelente! Quiero comprar el talla M negro, ¿a dónde transfiero?",
        estadoEnvio: "Guardado en respaldo local"
      }
    ];

    const EQUIPO_INICIAL = [
      { id: "usr-1", nombre: "Patricia Mago (Tú)", rol: "👑 Administradora Total", fijo: true },
      { id: "usr-2", nombre: "Asesor de Ventas #1", rol: "👤 Usuario Adjunto (Solo Chats y Tablero)", fijo: false }
    ];

    let configAgente = JSON.parse(localStorage.getItem("crm_fase3_config_agente")) || CONFIG_AGENTE_INICIAL;
    let catalogo = JSON.parse(localStorage.getItem("crm_fase2_catalogo")) || CATALOGO_INICIAL;
    let clientes = JSON.parse(localStorage.getItem("crm_fase2_clientes")) || CLIENTES_INICIALES;
    let chats = JSON.parse(localStorage.getItem("crm_fase2_chats")) || CHATS_INICIALES;
    let alertasTelegram = JSON.parse(localStorage.getItem("crm_fase3_telegram_log")) || ALERTAS_TELEGRAM_INICIALES;
    let equipoUsuarios = JSON.parse(localStorage.getItem("crm_fase4_equipo")) || EQUIPO_INICIAL;
    let textoRespuestaComentario = localStorage.getItem("crm_fase2_reply_comment") || "Te hemos enviado un DM 📨";

    function guardarMemoria() {
      localStorage.setItem("crm_fase3_config_agente", JSON.stringify(configAgente));
      localStorage.setItem("crm_fase2_catalogo", JSON.stringify(catalogo));
      localStorage.setItem("crm_fase2_clientes", JSON.stringify(clientes));
      localStorage.setItem("crm_fase2_chats", JSON.stringify(chats));
      localStorage.setItem("crm_fase3_telegram_log", JSON.stringify(alertasTelegram));
      localStorage.setItem("crm_fase4_equipo", JSON.stringify(equipoUsuarios));
      localStorage.setItem("crm_fase2_reply_comment", textoRespuestaComentario);
      renderizarEstadisticas();
    }

    // =========================================================================
    // MOTOR DE ESTADÍSTICAS Y GESTIÓN DE EQUIPO (FASE 4)
    // =========================================================================
    window.cambiarModoEstadisticas = function(modo) {
      modoEstadisticas = modo;
      const esReal = modo === "reales";

      document.getElementById("btnStatsReales").className = esReal
        ? "px-3.5 py-2 rounded-lg text-xs font-extrabold bg-white text-slate-900 shadow-sm transition"
        : "px-3.5 py-2 rounded-lg text-xs font-bold text-slate-600 hover:text-slate-900 transition";
      document.getElementById("btnStatsMuestra").className = !esReal
        ? "px-3.5 py-2 rounded-lg text-xs font-extrabold bg-white text-slate-900 shadow-sm transition"
        : "px-3.5 py-2 rounded-lg text-xs font-bold text-slate-600 hover:text-slate-900 transition";

      document.getElementById("avisoDatosMuestra").classList.toggle("hidden", esReal);
      renderizarEstadisticas();
    };

    function renderizarEstadisticas() {
      const elLeads = document.getElementById("statLeadsUnicos");
      if (!elLeads) return;

      if (modoEstadisticas === "muestra") {
        // Números de proyección estilo Kommo
        elLeads.textContent = "531";
        document.getElementById("statConversacionesIA").textContent = "653";
        document.getElementById("statTasaDerivacion").textContent = "12%";
        document.getElementById("statCantDerivados").textContent = "64 derivados";
        document.getElementById("statTiempoRespuesta").textContent = "25 s";
        document.getElementById("statSinResponder").textContent = "27";
        document.getElementById("statRespaldosTelegram").textContent = "64";
        document.getElementById("statCanalComentarios").textContent = "412 (63%)";
        document.getElementById("statCanalDM").textContent = "241 (37%)";
        document.getElementById("barraCanalComentarios").style.width = "63%";
        document.getElementById("barraCanalDM").style.width = "37%";
      } else {
        // Datos Reales en Vivo de tu CRM
        const totalLeads = clientes.length;
        const totalChats = chats.length;
        const derivadosHumano = chats.filter(c => c.estado === "humano").length;
        const porLeer = chats.filter(c => c.noLeido).length;
        const tasa = totalChats > 0 ? Math.round((derivadosHumano / totalChats) * 100) : 0;

        // Contar cuántas respuestas automáticas envió la IA
        let respuestasIA = 0;
        chats.forEach(c => {
          respuestasIA += c.mensajes.filter(m => m.autor === "ia_dm" || m.autor === "comentario_bot").length;
        });

        const porComentario = chats.filter(c => c.origen.includes("Comentario")).length;
        const porDM = totalChats - porComentario;
        const pctComentario = totalChats > 0 ? Math.round((porComentario / totalChats) * 100) : 50;
        const pctDM = totalChats > 0 ? (100 - pctComentario) : 50;

        elLeads.textContent = totalLeads;
        document.getElementById("statConversacionesIA").textContent = respuestasIA;
        document.getElementById("statTasaDerivacion").textContent = `${tasa}%`;
        document.getElementById("statCantDerivados").textContent = `${derivadosHumano} chats derivados`;
        document.getElementById("statTiempoRespuesta").textContent = `${configAgente.demora} s`;
        document.getElementById("statSinResponder").textContent = porLeer;
        document.getElementById("statRespaldosTelegram").textContent = alertasTelegram.length;

        document.getElementById("statCanalComentarios").textContent = `${porComentario} (${pctComentario}%)`;
        document.getElementById("statCanalDM").textContent = `${porDM} (${pctDM}%)`;
        document.getElementById("barraCanalComentarios").style.width = `${pctComentario}%`;
        document.getElementById("barraCanalDM").style.width = `${pctDM}%`;
      }

      // Desglose por etapas del Tablero
      const contEtapas = document.getElementById("desgloseEtapasStats");
      contEtapas.innerHTML = ETAPAS.map(e => {
        const cant = clientes.filter(c => c.etapa === e).length;
        return `
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 text-center">
            <span class="mono text-xl font-extrabold text-slate-900 block">${cant}</span>
            <span class="text-[11px] font-bold text-slate-500">${e}</span>
          </div>
        `;
      }).join("");

      // Lista de Usuarios del Equipo
      const contEquipo = document.getElementById("listaUsuariosEquipo");
      contEquipo.innerHTML = equipoUsuarios.map(u => `
        <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-200">
          <div>
            <p class="text-xs font-extrabold text-slate-900">${u.nombre}</p>
            <p class="text-[11px] text-slate-500">${u.rol}</p>
          </div>
          ${!u.fijo ? `<button onclick="eliminarUsuarioEquipo('${u.id}')" class="text-xs font-bold text-rose-600 hover:underline">Quitar</button>` : `<span class="text-[10px] font-bold bg-indigo-100 text-indigo-800 px-2 py-0.5 rounded">Principal</span>`}
        </div>
      `).join("");
    }

    window.eliminarUsuarioEquipo = function(id) {
      equipoUsuarios = equipoUsuarios.filter(u => u.id !== id);
      guardarMemoria();
    };

    document.getElementById("formNuevoUsuarioEquipo").addEventListener("submit", function(e) {
      e.preventDefault();
      const input = document.getElementById("inputNombreMiembro");
      if (!input.value.trim()) return;
      equipoUsuarios.push({
        id: "usr-" + Date.now(),
        nombre: input.value.trim(),
        rol: "👤 Usuario Adjunto (Solo Chats y Tablero)",
        fijo: false
      });
      input.value = "";
      guardarMemoria();
    });

    // =========================================================================
    // SONIDO Y TELEGRAM (FASE 3)
    // =========================================================================
    window.reproducirSonidoAlertaVenta = function() {
      try {
        const AudioCtx = window.AudioContext || window.webkitAudioContext;
        const ctx = new AudioCtx();

        const osc1 = ctx.createOscillator();
        const gain1 = ctx.createGain();
        osc1.type = "sine";
        osc1.frequency.setValueAtTime(587.33, ctx.currentTime);
        gain1.gain.setValueAtTime(0.25, ctx.currentTime);
        gain1.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.35);
        osc1.connect(gain1);
        gain1.connect(ctx.destination);
        osc1.start();
        osc1.stop(ctx.currentTime + 0.35);

        const osc2 = ctx.createOscillator();
        const gain2 = ctx.createGain();
        osc2.type = "sine";
        osc2.frequency.setValueAtTime(880, ctx.currentTime + 0.16);
        gain2.gain.setValueAtTime(0.3, ctx.currentTime + 0.16);
        gain2.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.7);
        osc2.connect(gain2);
        gain2.connect(ctx.destination);
        osc2.start(ctx.currentTime + 0.16);
        osc2.stop(ctx.currentTime + 0.7);
      } catch (e) {
        console.log("Audio listo");
      }
    };

    async function dispararAlertaCompra(clienteNombre, clienteIG, productoNombre, ultimoMensajeCliente) {
      if (configAgente.sonidoActivo) {
        reproducirSonidoAlertaVenta();
      }

      const toast = document.getElementById("toastAlertaVenta");
      document.getElementById("toastTituloCliente").textContent = `${clienteNombre} (${clienteIG})`;
      document.getElementById("toastDetalleVenta").textContent = `Quiere comprar: ${productoNombre} — "${ultimoMensajeCliente}"`;
      toast.classList.remove("hidden");

      let estadoEnvio = "Respaldo guardado en bitácora del CRM";
      const textoTelegram = `🚨 *NUEVA SOLICITUD DE COMPRA*\n\n👤 *Cliente:* ${clienteNombre} (${clienteIG})\n🛍️ *Producto:* ${productoNombre}\n💬 *Mensaje:* "${ultimoMensajeCliente}"\n📌 *Estado:* Derivado a Admin en etapa 'Esperando pago'.`;

      if (configAgente.tgBotToken && configAgente.tgChatId) {
        try {
          const url = `https://api.telegram.org/bot${configAgente.tgBotToken}/sendMessage`;
          const res = await fetch(url, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              chat_id: configAgente.tgChatId,
              text: textoTelegram,
              parse_mode: "Markdown"
            })
          });
          estadoEnvio = res.ok ? "✅ Enviado a tu Telegram en vivo" : "⚠️ Guardado en bitácora (Revisa tu Token/Chat ID)";
        } catch (err) {
          estadoEnvio = "⚠️ Guardado en bitácora local";
        }
      }

      alertasTelegram.unshift({
        id: "tg-" + Date.now(),
        fecha: "Ahora mismo",
        cliente: `${clienteNombre} (${clienteIG})`,
        producto: productoNombre,
        ultimoMensaje: ultimoMensajeCliente,
        estadoEnvio: estadoEnvio
      });

      guardarMemoria();
      renderizarBitacoraTelegram();
    }

    window.cerrarToastAlerta = function() {
      document.getElementById("toastAlertaVenta").classList.add("hidden");
    };

    window.probarEnvioTelegram = function() {
      guardarAjustesAgente();
      dispararAlertaCompra(
        "Cliente de Prueba",
        "@prueba_ig",
        "Franela Negra Talla XS ($25)",
        "¡Hola! Quiero pagar la Franela Negra XS ahora mismo."
      );
    };

    function renderizarBitacoraTelegram() {
      const contenedor = document.getElementById("bitacoraTelegram");
      const contador = document.getElementById("contadorAlertasTelegram");
      if (!contenedor) return;

      contador.textContent = `${alertasTelegram.length} respaldos`;
      contenedor.innerHTML = alertasTelegram.map(a => `
        <div class="bg-slate-800/90 border border-slate-700 rounded-xl p-3.5 space-y-1.5">
          <div class="flex items-center justify-between">
            <span class="text-[11px] font-extrabold text-sky-400">🚨 ALERTA DE COMPRA • ${a.fecha}</span>
            <span class="text-[10px] bg-slate-900 text-slate-300 px-2 py-0.5 rounded-md">${a.estadoEnvio}</span>
          </div>
          <p class="text-xs font-bold text-white">👤 Cliente: ${a.cliente}</p>
          <p class="text-xs text-emerald-300 font-semibold">🛍️ Producto: ${a.producto}</p>
          <p class="text-xs text-slate-300 italic">"${a.ultimoMensaje}"</p>
        </div>
      `).join("");
    }

    // =========================================================================
    // CONFIGURADOR DEL AGENTE IA
    // =========================================================================
    window.cambiarSubtabAgente = function(subtab) {
      ["personalidad", "acciones", "alertas"].forEach(s => {
        document.getElementById(`subtab-${s}`).classList.toggle("hidden", s !== subtab);
        const btn = document.getElementById(`subtab-btn-${s}`);
        btn.className = (s === subtab)
          ? "px-3.5 py-2 rounded-lg text-xs font-extrabold bg-white text-slate-900 shadow-sm transition flex items-center gap-1"
          : "px-3.5 py-2 rounded-lg text-xs font-bold text-slate-600 hover:text-slate-900 transition flex items-center gap-1";
      });
    };

    function cargarFormularioAgente() {
      document.getElementById("iaRol").value = configAgente.rol;
      document.getElementById("iaTono").value = configAgente.tono;
      document.getElementById("iaLongitud").value = configAgente.longitud;
      document.getElementById("iaDemora").value = configAgente.demora;
      document.getElementById("iaLimiteMensajes").value = configAgente.limiteMensajes;
      document.getElementById("iaMensajeTransferencia").value = configAgente.mensajeTransferencia;
      document.getElementById("checkSonidoActivo").checked = configAgente.sonidoActivo;
      document.getElementById("tgBotToken").value = configAgente.tgBotToken || "";
      document.getElementById("tgChatId").value = configAgente.tgChatId || "";
      renderizarPautasAgente();
      renderizarBitacoraTelegram();
    }

    function renderizarPautasAgente() {
      const cont = document.getElementById("listaPautasAgente");
      cont.innerHTML = configAgente.pautas.map((p, idx) => `
        <div class="flex items-center justify-between gap-3 p-3 rounded-xl bg-slate-50 border border-slate-200 text-xs text-slate-800">
          <span>${p}</span>
          <button onclick="eliminarPautaAgente(${idx})" class="text-rose-500 hover:text-rose-700 font-bold shrink-0">🗑️</button>
        </div>
      `).join("");
    }

    window.eliminarPautaAgente = function(idx) {
      configAgente.pautas.splice(idx, 1);
      guardarMemoria();
      renderizarPautasAgente();
    };

    document.getElementById("formNuevaPauta").addEventListener("submit", function(e) {
      e.preventDefault();
      const input = document.getElementById("inputNuevaPauta");
      if (!input.value.trim()) return;
      configAgente.pautas.push(input.value.trim());
      input.value = "";
      guardarMemoria();
      renderizarPautasAgente();
    });

    window.guardarAjustesAgente = function() {
      configAgente.rol = document.getElementById("iaRol").value.trim();
      configAgente.tono = document.getElementById("iaTono").value;
      configAgente.longitud = document.getElementById("iaLongitud").value;
      configAgente.demora = Number(document.getElementById("iaDemora").value) || 3;
      configAgente.limiteMensajes = Number(document.getElementById("iaLimiteMensajes").value) || 20;
      configAgente.mensajeTransferencia = document.getElementById("iaMensajeTransferencia").value.trim();
      configAgente.sonidoActivo = document.getElementById("checkSonidoActivo").checked;
      configAgente.tgBotToken = document.getElementById("tgBotToken").value.trim();
      configAgente.tgChatId = document.getElementById("tgChatId").value.trim();
      guardarMemoria();
    };

    // =========================================================================
    // ROLES, NAVEGACIÓN, CATÁLOGO, TABLERO Y CHATS
    // =========================================================================
    window.guardarConfigComentario = function(nuevoTexto) {
      textoRespuestaComentario = nuevoTexto.trim() || "Te hemos enviado un DM 📨";
      guardarMemoria();
    };

    window.cambiarRolSistema = function(nuevoRol) {
      rolActual = nuevoRol;
      const esAdmin = rolActual === "admin";

      document.getElementById("btnRolAdmin").className = esAdmin
        ? "px-3 py-1.5 rounded-lg text-xs font-bold bg-indigo-600 text-white transition"
        : "px-3 py-1.5 rounded-lg text-xs font-bold text-slate-300 hover:text-white transition";
      document.getElementById("btnRolAdjunto").className = !esAdmin
        ? "px-3 py-1.5 rounded-lg text-xs font-bold bg-amber-500 text-slate-950 transition"
        : "px-3 py-1.5 rounded-lg text-xs font-bold text-slate-300 hover:text-white transition";

      const badge = document.getElementById("badgeRolActual");
      badge.textContent = esAdmin ? "👑 Admin" : "👤 Usuario Adjunto";

      document.querySelectorAll(".solo-admin").forEach(el => {
        el.style.display = esAdmin ? "" : "none";
      });

      const aviso = document.getElementById("avisoRestriccionAdjunto");
      aviso.className = esAdmin
        ? "hidden"
        : "flex items-center gap-2 text-xs font-semibold text-amber-800 bg-amber-50 border border-amber-200 px-3 py-1.5 rounded-lg my-1";

      if (!esAdmin && ["catalogo", "agente", "stats"].includes(moduloActivoActual)) {
        mostrarModulo("chats");
      }
      renderizarTablero();
    };

    window.mostrarModulo = function(modulo) {
      if (rolActual !== "admin" && ["catalogo", "agente", "stats"].includes(modulo)) {
        alert("Acceso restringido: Tu rol de Usuario Adjunto solo permite atender la Bandeja de Chats y el Tablero de Clientes.");
        return;
      }
      moduloActivoActual = modulo;

      ["tablero", "chats", "catalogo", "agente", "stats"].forEach(m => {
        document.getElementById(`modulo-${m}`).classList.toggle("hidden", m !== modulo);
        const btn = document.getElementById(`nav-${m}`);
        if (btn) {
          btn.className = (m === modulo)
            ? "px-4 py-2 rounded-xl text-xs sm:text-sm font-bold bg-slate-900 text-white transition flex items-center gap-2"
            : "px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold text-slate-600 hover:bg-slate-100 transition flex items-center gap-2";
        }
      });

      if (modulo === "stats") renderizarEstadisticas();
    };

    function renderizarCatalogo() {
      const contenedor = document.getElementById("listaProductosCatalogo");
      const selectProdModal = document.getElementById("cliProducto");
      const selectProdSimulador = document.getElementById("simPostProducto");

      contenedor.innerHTML = catalogo.map(p => `
        <div class="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm flex flex-col justify-between">
          <div>
            <div class="flex items-start justify-between gap-2">
              <h4 class="font-extrabold text-slate-900 text-base">${p.nombre}</h4>
              <span class="mono font-extrabold text-sm bg-emerald-50 text-emerald-700 border border-emerald-200 px-2.5 py-0.5 rounded-lg">$${p.precio}</span>
            </div>
            <p class="text-xs text-slate-600 mt-1.5">${p.variantes}</p>
            <div class="mt-3 pt-3 border-t border-slate-100">
              <span class="text-[10px] font-bold uppercase text-slate-400 block mb-1">Palabras clave que activan el DM:</span>
              <div class="flex flex-wrap gap-1">
                ${p.keywords.split(",").map(k => `<span class="mono text-[11px] bg-indigo-50 text-indigo-700 px-2 py-0.5 rounded-md font-semibold">${k.trim()}</span>`).join("")}
              </div>
            </div>
          </div>
          <div class="mt-4 pt-2 border-t border-slate-100 flex items-center justify-between">
            <span class="text-[11px] font-bold text-slate-500">Estado: ${p.stock}</span>
            <button onclick="eliminarProducto('${p.id}')" class="text-xs font-bold text-rose-600 hover:underline">Eliminar</button>
          </div>
        </div>
      `).join("");

      if (selectProdModal) {
        selectProdModal.innerHTML = catalogo.map(p => `<option value="${p.nombre} ($${p.precio})">${p.nombre} ($${p.precio})</option>`).join("");
      }
      if (selectProdSimulador) {
        selectProdSimulador.innerHTML = catalogo.map(p => `<option value="${p.id}">${p.nombre} ($${p.precio})</option>`).join("");
      }
    }

    window.eliminarProducto = function(id) {
      catalogo = catalogo.filter(p => p.id !== id);
      guardarMemoria();
      renderizarCatalogo();
    };

    document.getElementById("formNuevoProducto").addEventListener("submit", function(e) {
      e.preventDefault();
      catalogo.unshift({
        id: "prod-" + Date.now(),
        nombre: document.getElementById("prodNombre").value.trim(),
        precio: Number(document.getElementById("prodPrecio").value),
        stock: document.getElementById("prodStock").value,
        variantes: document.getElementById("prodVariantes").value.trim(),
        keywords: document.getElementById("prodKeywords").value.trim()
      });
      guardarMemoria();
      renderizarCatalogo();
      e.target.reset();
    });

    function renderizarTablero() {
      ETAPAS.forEach(etapa => {
        const lista = clientes.filter(c => c.etapa === etapa);
        document.getElementById(`count-${etapa}`).textContent = lista.length;
        const col = document.getElementById(`col-${etapa}`);

        if (lista.length === 0) {
          col.innerHTML = `<div class="border-2 border-dashed border-slate-300/70 rounded-xl p-4 text-center text-xs text-slate-400">Sin clientes en esta etapa</div>`;
          return;
        }

        col.innerHTML = lista.map(c => `
          <div class="bg-white rounded-xl p-3.5 shadow-sm border border-slate-200/90 space-y-2.5">
            <div class="flex items-start justify-between gap-2">
              <div>
                <h4 class="font-bold text-sm text-slate-900">${c.nombre}</h4>
                <span class="mono text-[11px] text-indigo-600 font-semibold">${c.ig || "Sin IG"}</span>
              </div>
              ${rolActual === "admin" ? `<button onclick="eliminarCliente('${c.id}')" class="text-[11px] text-slate-400 hover:text-rose-600">🗑️</button>` : ""}
            </div>
            <div class="text-xs font-semibold text-slate-800 bg-slate-50 px-2.5 py-1.5 rounded-lg border border-slate-200/60">
              🛍️ ${c.producto}
            </div>
            ${c.nota ? `<p class="text-xs text-slate-600 italic">"${c.nota}"</p>` : ""}
            <div class="pt-1 flex items-center gap-1.5">
              <select onchange="moverEtapaCliente('${c.id}', this.value)" class="flex-1 text-xs font-semibold bg-slate-50 border border-slate-200 rounded-lg px-2 py-1.5 text-slate-700">
                ${ETAPAS.map(e => `<option value="${e}" ${e === c.etapa ? "selected" : ""}>${e}</option>`).join("")}
              </select>
              <button onclick="irAlChatDelCliente('${c.id}')" class="px-2.5 py-1.5 rounded-lg bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-bold" title="Ver chat">
                💬
              </button>
            </div>
          </div>
        `).join("");
      });
    }

    window.irAlChatDelCliente = function(clienteId) {
      const chat = chats.find(ch => ch.clienteId === clienteId);
      mostrarModulo("chats");
      if (chat) seleccionarChat(chat.id);
    };

    window.moverEtapaCliente = function(id, nuevaEtapa) {
      const cli = clientes.find(c => c.id === id);
      if (cli) {
        cli.etapa = nuevaEtapa;
        const ch = chats.find(chat => chat.clienteId === id);
        if (ch && ["Esperando pago", "Vendido"].includes(nuevaEtapa)) {
          ch.estado = "humano";
        }
        guardarMemoria();
        renderizarTablero();
        renderizarBandejaChats();
      }
    };

    window.eliminarCliente = function(id) {
      if (rolActual !== "admin") return;
      clientes = clientes.filter(c => c.id !== id);
      chats = chats.filter(ch => ch.clienteId !== id);
      guardarMemoria();
      renderizarTablero();
      renderizarBandejaChats();
    };

    function actualizarContadoresBandeja() {
      const cantHumano = chats.filter(c => c.estado === "humano").length;
      const cantNoLeido = chats.filter(c => c.noLeido).length;

      document.getElementById("badgeFiltroHumano").textContent = cantHumano;
      document.getElementById("badgeFiltroNoLeido").textContent = cantNoLeido;
      document.getElementById("contadorTotalChats").textContent = `${chats.length} conversaciones`;

      const badgeMenu = document.getElementById("badgeMenuChats");
      const urgentes = cantHumano + cantNoLeido;
      if (badgeMenu) {
        badgeMenu.textContent = urgentes;
        badgeMenu.style.display = urgentes > 0 ? "inline-block" : "none";
      }
    }

    window.filtrarBandejaChats = function(filtro) {
      filtroChatActual = filtro;
      ["todos", "humano", "no_leido", "ia"].forEach(f => {
        const btn = document.getElementById(`filtroChat-${f}`);
        if (btn) {
          btn.className = (f === filtro)
            ? "py-1.5 px-2 rounded-lg bg-white text-slate-900 shadow-sm transition flex items-center justify-center gap-1"
            : "py-1.5 px-2 rounded-lg text-slate-600 hover:text-slate-900 transition flex items-center justify-center gap-1";
        }
      });
      renderizarBandejaChats();
    };

    function renderizarBandejaChats() {
      actualizarContadoresBandeja();
      const contenedor = document.getElementById("listaConversaciones");

      let listaFiltrada = chats;
      if (filtroChatActual === "humano") listaFiltrada = chats.filter(c => c.estado === "humano");
      if (filtroChatActual === "no_leido") listaFiltrada = chats.filter(c => c.noLeido);
      if (filtroChatActual === "ia") listaFiltrada = chats.filter(c => c.estado === "ia");

      if (listaFiltrada.length === 0) {
        contenedor.innerHTML = `<div class="p-8 text-center text-xs text-slate-400">No hay conversaciones en este filtro.</div>`;
        return;
      }

      contenedor.innerHTML = listaFiltrada.map(ch => {
        const ultimoMsg = ch.mensajes[ch.mensajes.length - 1];
        const activo = ch.id === chatSeleccionadoId;
        return `
          <div onclick="seleccionarChat('${ch.id}')" class="p-3.5 cursor-pointer transition hover:bg-slate-50 ${activo ? 'bg-indigo-50/70 border-l-4 border-indigo-600' : ''}">
            <div class="flex items-start justify-between gap-2">
              <div class="flex items-center gap-2">
                ${ch.noLeido ? `<span class="w-2.5 h-2.5 rounded-full bg-amber-500 shrink-0"></span>` : ""}
                <h4 class="font-extrabold text-sm text-slate-900">${ch.nombre}</h4>
              </div>
              <span class="text-[10px] font-semibold text-slate-400">${ch.hora}</span>
            </div>
            <div class="flex items-center gap-1.5 mt-1">
              <span class="mono text-[11px] text-indigo-600 font-semibold">${ch.ig}</span>
              <span class="text-[10px] px-2 py-0.5 rounded-full font-bold ${ch.estado === 'humano' ? 'bg-rose-100 text-rose-700' : 'bg-emerald-100 text-emerald-800'}">
                ${ch.estado === 'humano' ? '🔴 Requiere Humano' : '🤖 Atendido por IA'}
              </span>
            </div>
            <p class="text-xs text-slate-600 truncate mt-1.5">${ultimoMsg ? ultimoMsg.texto : ""}</p>
          </div>
        `;
      }).join("");

      renderizarChatActivo();
    }

    window.seleccionarChat = function(id) {
      chatSeleccionadoId = id;
      const ch = chats.find(c => c.id === id);
      if (ch) {
        ch.noLeido = false;
        guardarMemoria();
      }
      renderizarBandejaChats();
    };

    function renderizarChatActivo() {
      const ch = chats.find(c => c.id === chatSeleccionadoId);
      const header = document.getElementById("headerChatActivo");
      const contenedorMensajes = document.getElementById("mensajesChatActivo");

      if (!ch) return;

      const clienteVinculado = clientes.find(cli => cli.id === ch.clienteId);
      const etapaActual = clienteVinculado ? clienteVinculado.etapa : "Pidió info";

      header.innerHTML = `
        <div>
          <div class="flex items-center gap-2">
            <h3 class="font-extrabold text-base text-slate-900">${ch.nombre}</h3>
            <span class="mono text-xs text-indigo-600 font-bold">${ch.ig}</span>
            <span class="text-[11px] bg-slate-200 text-slate-700 font-semibold px-2 py-0.5 rounded-md">
              Origen: ${ch.origen}
            </span>
          </div>
          <p class="text-xs text-slate-500 mt-0.5">Interés: <strong>${ch.producto}</strong> • Tono IA: <strong>${configAgente.tono}</strong></p>
        </div>

        <div class="flex flex-wrap items-center gap-2">
          <button onclick="alternarModoAgenteChat('${ch.id}')" class="px-3 py-1.5 rounded-xl text-xs font-bold border transition ${
            ch.estado === 'humano'
              ? 'bg-rose-50 text-rose-700 border-rose-200 hover:bg-rose-100'
              : 'bg-emerald-50 text-emerald-700 border-emerald-200 hover:bg-emerald-100'
          }">
            ${ch.estado === 'humano' ? '🔴 Atendiendo Humano (Reactivar IA)' : '🤖 Agente IA Activo (Derivar a Humano)'}
          </button>

          ${clienteVinculado ? `
            <select onchange="moverEtapaCliente('${clienteVinculado.id}', this.value)" class="text-xs font-bold bg-white border border-slate-300 rounded-xl px-2.5 py-1.5 text-slate-800">
              ${ETAPAS.map(e => `<option value="${e}" ${e === etapaActual ? "selected" : ""}>Etapa: ${e}</option>`).join("")}
            </select>
          ` : ""}
        </div>
      `;

      contenedorMensajes.innerHTML = ch.mensajes.map(m => {
        if (m.autor === "comentario_cliente") {
          return `
            <div class="bg-amber-50 border border-amber-200 rounded-2xl p-3 text-xs max-w-lg">
              <span class="font-extrabold text-amber-900 block mb-1">💬 Comentó en tu Post de Instagram (${m.hora}):</span>
              <p class="text-slate-800">"${m.texto}"</p>
            </div>
          `;
        }
        if (m.autor === "comentario_bot") {
          return `
            <div class="bg-indigo-50 border border-indigo-200 rounded-2xl p-3 text-xs max-w-lg ml-6">
              <span class="font-extrabold text-indigo-900 block mb-1">↪️ Respuesta automática en el comentario público:</span>
              <p class="text-indigo-950 font-semibold">"${m.texto}"</p>
            </div>
          `;
        }
        if (m.autor === "sistema") {
          return `
            <div class="bg-rose-50 border border-rose-200 text-rose-800 rounded-xl p-2.5 text-center text-xs font-bold">
              ${m.texto}
            </div>
          `;
        }
        const esCliente = m.autor === "cliente_dm";
        const etiquetaAutor = esCliente
          ? `${ch.nombre} (DM)`
          : (m.autor === "ia_dm" ? "🤖 Agente IA" : "👩‍💻 Asesor Humano");

        return `
          <div class="flex flex-col ${esCliente ? 'items-start' : 'items-end'}">
            <span class="text-[10px] font-bold text-slate-400 mb-1 px-1">${etiquetaAutor} • ${m.hora}</span>
            <div class="max-w-md rounded-2xl px-4 py-2.5 text-xs sm:text-sm leading-relaxed shadow-sm ${
              esCliente
                ? 'bg-white border border-slate-200 text-slate-800'
                : (m.autor === 'ia_dm' ? 'bg-indigo-600 text-white' : 'bg-slate-900 text-white')
            }">
              ${m.texto}
            </div>
          </div>
        `;
      }).join("");

      contenedorMensajes.scrollTop = contenedorMensajes.scrollHeight;
    }

    window.alternarModoAgenteChat = function(chatId) {
      const ch = chats.find(c => c.id === chatId);
      if (!ch) return;
      ch.estado = ch.estado === "ia" ? "humano" : "ia";
      guardarMemoria();
      renderizarBandejaChats();
    };

    window.ejecutarSeguimientoInactividad = function() {
      const ch = chats.find(c => c.id === chatSeleccionadoId);
      if (!ch) return;

      const oracionSeguimiento = `Quedo pendiente por aquí para confirmarte la disponibilidad de tu talla en ${ch.producto} y ayudarte a reservarla cuando gustes.`;

      ch.mensajes.push({
        autor: "ia_dm",
        texto: oracionSeguimiento,
        hora: "Seguimiento 15m"
      });

      guardarMemoria();
      renderizarBandejaChats();
    };

    window.simularRespuestaClienteDM = function(textoCliente) {
      const ch = chats.find(c => c.id === chatSeleccionadoId);
      if (!ch) return;

      ch.mensajes.push({
        autor: "cliente_dm",
        texto: textoCliente,
        hora: "Ahora"
      });

      const quiereComprar = textoCliente.toLowerCase().includes("comprar") || textoCliente.toLowerCase().includes("pago");
      const cli = clientes.find(c => c.id === ch.clienteId);

      if (quiereComprar) {
        ch.estado = "humano";
        ch.noLeido = true;
        if (cli) {
          cli.etapa = "Esperando pago";
          cli.nota = "🔥 Listo para comprar -> Alerta enviada a Admin y Telegram.";
        }

        ch.mensajes.push({
          autor: "ia_dm",
          texto: configAgente.mensajeTransferencia,
          hora: "Ahora"
        });
        ch.mensajes.push({
          autor: "sistema",
          texto: "🔴 Intención de compra detectada: El Agente IA pausó su respuesta, activó la alerta sonora y envió el respaldo a Telegram.",
          hora: "Ahora"
        });

        dispararAlertaCompra(ch.nombre, ch.ig, ch.producto, textoCliente);
      } else {
        ch.mensajes.push({
          autor: "ia_dm",
          texto: `Sobre ${ch.producto}, contamos con disponibilidad inmediata. Si deseas reservar tu talla, confírmame por aquí para pasarte con nuestro especialista 😊`,
          hora: "Ahora"
        });
      }

      guardarMemoria();
      renderizarTablero();
      renderizarBandejaChats();
    };

    document.getElementById("formSimularInteraccionIG").addEventListener("submit", function(e) {
      e.preventDefault();
      const tipo = document.getElementById("simTipoEntrada").value;
      const igRaw = document.getElementById("simUsuarioIG").value.trim();
      const ig = igRaw.startsWith("@") ? igRaw : "@" + igRaw;
      const nombre = document.getElementById("simNombreCliente").value.trim();
      const prodId = document.getElementById("simPostProducto").value;
      const texto = document.getElementById("simTextoCliente").value.trim();

      const producto = catalogo.find(p => p.id === prodId) || catalogo[0];
      const nuevoCliId = "cli-" + Date.now();
      const nuevoChatId = "chat-" + Date.now();

      const respuestaDM = `¡Hola! Un gusto saludarte. El costo de ${producto.nombre} es de $${producto.precio}, ${producto.variantes} por si te interesa. ¿Qué talla o modelo buscas?`;

      const nuevosMensajes = [];
      if (tipo === "comentario") {
        nuevosMensajes.push({ autor: "comentario_cliente", texto: texto, hora: "Ahora" });
        nuevosMensajes.push({ autor: "comentario_bot", texto: textoRespuestaComentario, hora: "Ahora" });
      } else {
        nuevosMensajes.push({ autor: "cliente_dm", texto: texto, hora: "Ahora" });
      }
      nuevosMensajes.push({ autor: "ia_dm", texto: respuestaDM, hora: "Ahora" });

      clientes.unshift({
        id: nuevoCliId,
        nombre: nombre,
        producto: `${producto.nombre} ($${producto.precio})`,
        etapa: "Pasé precio",
        ig: ig,
        nota: tipo === "comentario"
          ? `Comentó "${texto}" -> El Bot respondió en post y envió precio al DM.`
          : `Escribió al DM "${texto}" -> Atendido por el Agente IA.`
      });

      chats.unshift({
        id: nuevoChatId,
        clienteId: nuevoCliId,
        nombre: nombre,
        ig: ig,
        producto: producto.nombre,
        origen: tipo === "comentario" ? "Comentario en Post IG" : "Escribió directo al DM",
        estado: "ia",
        noLeido: true,
        hora: "Ahora",
        mensajes: nuevosMensajes
      });

      chatSeleccionadoId = nuevoChatId;
      guardarMemoria();
      renderizarTablero();
      renderizarBandejaChats();
      e.target.reset();
    });

    document.getElementById("formEnviarMensajeHumano").addEventListener("submit", function(e) {
      e.preventDefault();
      const input = document.getElementById("inputMensajeHumano");
      const texto = input.value.trim();
      if (!texto) return;

      const ch = chats.find(c => c.id === chatSeleccionadoId);
      if (!ch) return;

      ch.mensajes.push({ autor: "humano_dm", texto: texto, hora: "Ahora" });
      ch.noLeido = false;
      guardarMemoria();
      renderizarBandejaChats();
      input.value = "";
    });

    window.abrirModalNuevoCliente = () => {
      document.getElementById("modalNuevoCliente").classList.remove("hidden");
      document.getElementById("modalNuevoCliente").classList.add("flex");
    };

    window.cerrarModalNuevoCliente = () => {
      document.getElementById("modalNuevoCliente").classList.add("hidden");
      document.getElementById("modalNuevoCliente").classList.remove("flex");
    };

    document.getElementById("formNuevoCliente").addEventListener("submit", function(e) {
      e.preventDefault();
      const nuevoCliId = "cli-" + Date.now();
      const nombre = document.getElementById("cliNombre").value.trim();
      const prod = document.getElementById("cliProducto").value;
      const etapa = document.getElementById("cliEtapa").value;
      const ig = document.getElementById("cliIg").value.trim() || "@cliente";
      const nota = document.getElementById("cliNota").value.trim();

      clientes.unshift({ id: nuevoCliId, nombre, producto: prod, etapa, ig, nota });
      chats.unshift({
        id: "chat-" + Date.now(),
        clienteId: nuevoCliId,
        nombre,
        ig,
        producto: prod,
        origen: "Registro Manual",
        estado: "humano",
        noLeido: false,
        hora: "Ahora",
        mensajes: [{ autor: "sistema", texto: `Cliente registrado manualmente en etapa: ${etapa}`, hora: "Ahora" }]
      });

      guardarMemoria();
      renderizarTablero();
      renderizarBandejaChats();
      cerrarModalNuevoCliente();
      e.target.reset();
    });

    // Inicializar todo el CRM (Fases 1, 2, 3 y 4)
